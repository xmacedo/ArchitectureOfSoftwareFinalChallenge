@startuml ClienteAPI

package "Controller Layer" {
    class ClienteController {
        - clienteService: ClienteService
        + listarTodos(): ResponseEntity<?>
        + buscarPorID(id: Long): ResponseEntity<?>
        + buscarPorNome(nome: String): ResponseEntity<?>
        + createClient(clientRequestDTO: ClienteRequestDTO): ResponseEntity<?>
        + contarClientes(): ResponseEntity<?>
        + deletarCliente(id: Long): ResponseEntity<?>
    }
}

package "Service Layer" {
    class ClienteService {
        + findAll(): List<ClienteResponseDTO>
        + findById(id: Long): Optional<ClienteResponseDTO>
        + findByName(nome: String): List<ClienteResponseDTO>
        + createOrSave(clienteRequestDTO: ClienteRequestDTO): ClienteResponseDTO
        + countingClients(): Long
        + deleteClientById(id: Long): void
    }
}

package "DTO Layer" {
